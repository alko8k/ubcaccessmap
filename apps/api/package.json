{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "build": "tsc --noEmit",
    "start": "tsx --conditions=development src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx --conditions=development prisma/seed.ts",
    "db:import": "tsx --conditions=development src/scripts/import-ubc-buildings.ts"
  },
  "prisma": {
    "seed": "tsx --conditions=development prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@ubc-access-map/shared": "*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "nodemailer": "^10.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.16.2",
    "supertest": "^7.1.4",
    "tsx": "^4.23.12",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
